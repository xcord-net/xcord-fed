{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "Snowflake": {
    "WorkerId": 1
  },
  "RateLimiting": {
    "MaxRequests": 100,
    "WindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Hub": {
    "Enabled": false,
    "Origin": null
  },
  "Captcha": {
    "Enabled": true
  },
  "Outbox": {
    "PollingIntervalMs": 100,
    "RetentionMinutes": 60,
    "CleanupIntervalMinutes": 5,
    "MaxRetryCount": 10,
    "BatchSize": 50
  }
}
